# ETAT-MAJOR SNIPER EA - variables d'environnement (exemple)
#
# AUCUNE de ces variables n'est requise en Phase 2 (laboratoire) :
# le moteur n'ouvre aucune connexion et n'accède à aucun compte.
#
# Copiez ce fichier en `.env` et complétez uniquement au moment où un
# adaptateur broker réel existera (Phase 9). NE COMMITTEZ JAMAIS le fichier
# `.env` : il est ignoré par `.gitignore`.
#
# Rappel : les identifiants de compte MT5 ne doivent jamais être stockés dans
# le dépôt. Utilisez un coffre de secrets ou des variables d'environnement
# injectées au moment de l'exécution.

# --- Journalisation -------------------------------------------------------
# ETATMADOR_LOG_LEVEL=INFO

# --- Phase 9 : adaptateur MT5 (non implémenté, à titre de référence) -------
# MT5_TERMINAL_PATH=C:\\Program Files\\MetaTrader 5\\terminal64.exe
# MT5_ACCOUNT_LOGIN=
# MT5_ACCOUNT_PASSWORD=
# MT5_ACCOUNT_SERVER=
# MT5_ACCOUNT_NAME=
# MT5_SYMBOLS=EURUSD
# MT5_MAGIC_NUMBER=20260105

# --- Phase 10 : activation de la production (jamais activée par défaut) ----
# ETATMADOR_ENABLE_LIVE=false
# ETATMADOR_LIVE_AUTHORISED_BY=
